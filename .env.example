# Public site origin used for canonical, Open Graph and sitemap URLs.
# Leave unset in local preview to keep pages noindex without inventing a domain.
NEXT_PUBLIC_SITE_URL=

# Supabase public client for live directory + companions roster reads.
# Required for /venue/[slug] to load rows from public.companions (anon key).
# When unset, venue pages fall back to sanitized local seed ladies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only keys — never expose these to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional alias accepted by scrape:seed
SUPABASE_SECRET_KEY=
# Postgres password (Settings → Database). Needed to apply SQL migrations from the agent/CLI.
SUPABASE_DB_PASSWORD=
ADMIN_PANEL_KEY=
ADMIN_OPEN_IDS=
ADMIN_APP_ORIGIN=
# Optional public WeChat ID fallback for sticky CTA / QR dialog.
NEXT_PUBLIC_WECHAT_CONTACT_ID=
# Server-only alias (also accepted when building venue consumer views).
WECHAT_CONTACT_ID=
