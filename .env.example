# Public site origin used for canonical, Open Graph and sitemap URLs.
# Leave unset in local preview to keep pages noindex without inventing a domain.
NEXT_PUBLIC_SITE_URL=

# Supabase public client for live directory + companions roster reads.
# Required for /venue/[slug] to load rows from public.companions (anon key).
# When unset, venue pages fall back to sanitized local seed ladies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only keys — never expose these to the browser.
# Service role is required for /manage/[venueId] roster mutations.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional JSON map of venue owner PIN overrides, e.g. {"melb-1":"8014"}
# Preferred source after migration: public.venues.manager_pin
# Master admin PIN 8899 always unlocks any venue (app-enforced).
VENUE_OWNER_PINS=
# Optional alias accepted by scrape:seed
SUPABASE_SECRET_KEY=
# Postgres password (Settings → Database). Needed to apply SQL migrations from the agent/CLI.
SUPABASE_DB_PASSWORD=
ADMIN_PANEL_KEY=
ADMIN_OPEN_IDS=
ADMIN_APP_ORIGIN=
# Optional public WeChat ID fallback for sticky CTA / QR dialog.
NEXT_PUBLIC_WECHAT_CONTACT_ID=
# Server-only alias (also accepted when building venue consumer views).
WECHAT_CONTACT_ID=
# Platform WhatsApp support number (international or AU local). Used when a
# venue has no custom WhatsApp / phone, and for /manage admin support chat.
NEXT_PUBLIC_WHATSAPP_SUPPORT_NUMBER=
WHATSAPP_SUPPORT_NUMBER=
# Partners / Business Sales WhatsApp desk (QR deep link).
NEXT_PUBLIC_PARTNER_WHATSAPP_HREF=https://wa.me/qr/UT73CCOMEKMSI1
