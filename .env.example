# Public site origin used for canonical, Open Graph and sitemap URLs.
# Leave unset in local preview to keep pages noindex without inventing a domain.
NEXT_PUBLIC_SITE_URL=

# Optional Supabase public client (directory reads). Demo feed is used when unset.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only keys — never expose these to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional alias accepted by scrape:seed
SUPABASE_SECRET_KEY=
ADMIN_OPEN_IDS=
ADMIN_APP_ORIGIN=
WECHAT_CONTACT_ID=
